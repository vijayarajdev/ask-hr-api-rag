# Normalize line endings for all text files to LF in the repository.
# Git will convert to the OS native line ending on checkout (CRLF on Windows).
* text=auto eol=lf

# Python source
*.py text eol=lf

# Config and markup
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.env   text eol=lf

# Shell scripts must always be LF regardless of platform
*.sh text eol=lf

# Windows batch files should stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — no line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.zip  binary
*.gz   binary
*.tar  binary
